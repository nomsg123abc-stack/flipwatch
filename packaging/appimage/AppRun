#!/usr/bin/env bash
set -euo pipefail
APP_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/flipwatch"
mkdir -p "$DATA_DIR"
export NODE_ENV=production
export PORT="${PORT:-3000}"
export HOSTNAME=127.0.0.1
export PGLITE_DIR="${PGLITE_DIR:-$DATA_DIR/pglite}"
export APP_URL="${APP_URL:-http://127.0.0.1:$PORT}"
export SESSION_SECRET="${SESSION_SECRET:-$("$APP_DIR/usr/bin/node" -e 'process.stdout.write(require("crypto").randomBytes(32).toString("base64"))')}"
export PATH="$APP_DIR/usr/bin:$PATH"
export FLIPWATCH_APP_DIR="$APP_DIR"
"$APP_DIR/usr/bin/node" "$APP_DIR/usr/share/flipwatch/server.js" &
server_pid=$!
cleanup() {
  kill "$server_pid" 2>/dev/null || true
  wait "$server_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM
for _ in $(seq 1 90); do
  if ! kill -0 "$server_pid" 2>/dev/null; then
    wait "$server_pid"
    exit $?
  fi
  if curl -fsS "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "http://127.0.0.1:$PORT" >/dev/null 2>&1 || true
fi
wait "$server_pid"
